<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FAFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Cabecera roja de alerta (Integración total) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#EF4444"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="20dp"
                android:paddingBottom="64dp">

                <ImageButton
                    android:id="@+id/btnBackArrowSOS"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#FFFFFF"
                    android:contentDescription="Volver" />

                <TextView
                    android:id="@+id/textAlertTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="¡SOS ACTIVADO!"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/textCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Notificando en 10s"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textNotifyingContacts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="Avisando a: Juan y Ana"
                    android:textColor="#FEE2E2"
                    android:textSize="18sp"
                    android:textStyle="italic" />
            </LinearLayout>

            <!-- Acciones (Botones Gigantes para Emergencia) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <Button
                    android:id="@+id/btnCancelSOS"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginBottom="16dp"
                    android:backgroundTint="#10B981"
                    android:text="ESTOY BIEN, CANCELAR"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:cornerRadius="25dp"
                    app:elevation="4dp" />

                <Button
                    android:id="@+id/btnConfirmSOSNow"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginBottom="24dp"
                    android:backgroundTint="#EF4444"
                    android:text="NECESITO AYUDA YA"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:cornerRadius="25dp"
                    app:elevation="4dp" />

                <Button
                    android:id="@+id/btnViewMedicalProfile"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="VER MI PERFIL MÉDICO"
                    android:textColor="#1457D9"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>