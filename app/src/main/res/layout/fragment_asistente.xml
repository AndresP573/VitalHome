<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7FAFF"
    android:paddingTop="36dp"
    android:paddingHorizontal="16dp"
    android:paddingBottom="8dp">

    <!-- Encabezado de VitalBot -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🤖 VitalBot - Asistente IA"
            android:textColor="#0A2E73"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Área de la respuesta de la IA (Usa layout_weight="1" para adaptarse dinámicamente al teclado) -->
    <ScrollView
        android:id="@+id/scrollViewAsistente"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="4dp">

        <TextView
            android:id="@+id/tvRespuestaIA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¡Hola! Soy VitalBot 🤖\n¿En qué te puedo ayudar hoy sobre tus medicamentos, recordatorios o el estado de tu hogar?"
            android:textColor="#1E293B"
            android:textSize="18sp"
            android:lineSpacingExtra="6dp"
            android:background="#FFFFFF"
            android:padding="20dp" />
    </ScrollView>

    <!-- Contenedor inferior de entrada de texto (Permanentemente visible y flotando sobre el teclado) -->
    <LinearLayout
        android:id="@+id/inputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:padding="4dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="28dp"
            app:strokeColor="#CBD5E1"
            app:strokeWidth="1.5dp"
            app:cardElevation="2dp">

            <EditText
                android:id="@+id/etPregunta"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Escribe tu consulta aquí..."
                android:background="@android:color/transparent"
                android:paddingHorizontal="20dp"
                android:textColor="#1E293B"
                android:textSize="16sp"
                android:inputType="textLongMessage" />
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnEnviarIA"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginStart="10dp"
            android:text="Enviar"
            android:textAllCaps="false"
            android:backgroundTint="#1457D9"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:cornerRadius="28dp" />
    </LinearLayout>

</LinearLayout>
