<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7FAFF"
    android:padding="16dp">

    <!-- Encabezado de VitalBot -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🤖 VitalBot - Asistente IA"
            android:textColor="#1E293B"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Área de la respuesta de la IA -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvRespuestaIA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¡Hola! Soy VitalBot 🤖\n¿En qué te puedo ayudar hoy sobre tus medicamentos, recordatorios o el estado de tu hogar?"
            android:textColor="#334155"
            android:textSize="18sp"
            android:lineSpacingExtra="4dp"
            android:background="#FFFFFF"
            android:padding="16dp" />
    </ScrollView>

    <!-- Contenedor inferior de entrada de texto y botón elevado 110dp por encima de la barra -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="110dp"
        android:paddingTop="8dp">

        <EditText
            android:id="@+id/etPregunta"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:hint="Escribe tu consulta aquí..."
            android:background="#FFFFFF"
            android:paddingHorizontal="16dp"
            android:textColor="#1E293B"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnEnviarIA"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:text="Enviar"
            android:textAllCaps="false"
            android:backgroundTint="#2563EB"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>
