<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F7FAFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <View
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@android:color/holo_blue_dark"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vitalhome_title"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#0A2E73"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vitalhome_tagline"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#62708A"
            android:layout_marginBottom="30dp"/>

        <EditText
            android:id="@+id/etEmailLogin"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="@string/email_hint"
            android:inputType="textEmailAddress"
            android:autofillHints="emailAddress"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etPasswordLogin"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="@string/password_hint"
            android:inputType="textPassword"
            android:autofillHints="password"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¿Cómo quieres ingresar?"
            android:textColor="#0A2E73"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

        <RadioGroup
            android:id="@+id/rgLoginRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rbLoginAdulto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Abuelo"
                android:paddingEnd="16dp"
                android:textStyle="bold"
                android:minHeight="48dp"/>

            <RadioButton
                android:id="@+id/rbLoginCuidador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cuidador"
                android:checked="true"
                android:textStyle="bold"
                android:minHeight="48dp"/>
        </RadioGroup>

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="@string/login_button"
            android:backgroundTint="#1457D9"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvGoToRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center"
            android:text="@string/register_prompt"
            android:textColor="#1457D9"
            android:layout_marginTop="24dp"
            android:textStyle="bold"
            android:textSize="16sp"/>

    </LinearLayout>
</ScrollView>