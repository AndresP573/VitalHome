<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="40dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="30dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🩺 Tu Salud"
            android:textColor="#1457D9"
            android:textSize="32sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="25dp"
            android:background="#D8E3F5" />

        <TextView
            android:id="@+id/tvPopPulso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="72 LPM"
            android:textColor="#0A2E73"
            android:textSize="56sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PULSO"
            android:textColor="#62708A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="25dp"
            android:background="#D8E3F5" />

        <TextView
            android:id="@+id/tvPopOxigeno"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="98%"
            android:textColor="#0A2E73"
            android:textSize="56sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OXÍGENO"
            android:textColor="#62708A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="25dp"
            android:background="#D8E3F5" />

        <TextView
            android:id="@+id/tvPopPresion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="120/80"
            android:textColor="#0A2E73"
            android:textSize="56sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRESIÓN"
            android:textColor="#62708A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCerrarPop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:backgroundTint="#10B981"
            android:padding="20dp"
            android:text="👍 ¡ESTOY BIEN!"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            app:cornerRadius="25dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>