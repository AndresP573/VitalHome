<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F7FAFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/create_account"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#0A2E73"
        android:layout_marginBottom="32dp"/>

    <EditText
        android:id="@+id/etNombreRegister"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:hint="@string/name_hint"
        android:inputType="textPersonName"
        android:autofillHints="name"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etEmailRegister"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:hint="@string/email_hint"
        android:inputType="textEmailAddress"
        android:autofillHints="emailAddress"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etPasswordRegister"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:hint="@string/password_hint"
        android:inputType="textPassword"
        android:autofillHints="password"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/who_uses_app"
        android:textColor="#0A2E73"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <RadioGroup
        android:id="@+id/rgRol"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="start"
        android:layout_marginBottom="24dp">
        <RadioButton
            android:id="@+id/rbCliente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/role_adulto_mayor"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>
        <RadioButton
            android:id="@+id/rbCuidador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/role_cuidador"
            android:textSize="18sp"
            android:textStyle="bold"
            android:checked="true"/>
    </RadioGroup>

    <Button
        android:id="@+id/btnRegister"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:text="@string/register_button"
        android:backgroundTint="#1457D9"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/tvGoToLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/go_to_login"
        android:textColor="#1457D9"
        android:layout_marginTop="24dp"
        android:textStyle="bold"
        android:textSize="16sp"/>

</LinearLayout>